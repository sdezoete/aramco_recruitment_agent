# Recruitment Agent settings. Copy to .env. Never commit or ship .env.
# On the server, scripts\2-install-offline.ps1 creates .env from this file with PRODUCTION=True.

# --- Mode ---------------------------------------------------------------
# False on the development machine, True on the production server.
PRODUCTION=False

# --- Web server ---------------------------------------------------------
HOST=127.0.0.1
PORT=8000
# Required when PRODUCTION=True (PEM; certificate with the intermediates appended).
TLS_CERT_FILE=
TLS_KEY_FILE=

# --- Database (SQL Server) ----------------------------------------------
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_SERVER=localhost
DB_NAME=recruitment
# yes = Windows authentication; no = use DB_USER/DB_PASSWORD
DB_TRUSTED_CONNECTION=yes
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=no
DB_TRUST_SERVER_CERTIFICATE=yes

# --- LLM (OpenAI-compatible chat-completions) ---------------------------
# Dev: OpenAI (https://api.openai.com/v1, e.g. gpt-5.4-mini); empty LLM_API_KEY falls back to OPENAI_API_KEY.
# Server: the corporate MaaS gateway URL ending in /v1, its key, and the exact DeepSeek 4.1 Flash model id
# (list ids: Invoke-RestMethod <LLM_BASE_URL>/models -Headers @{Authorization="Bearer <key>"}).
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# harmony "Reasoning:" level (low|medium|high); also sent as reasoning_effort when the endpoint accepts it
LLM_REASONING_EFFORT=medium
LLM_DISPLAY_NAME=ARIF
LLM_VERIFY_SSL=True
LLM_CA_FILE=
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=4096
LLM_MAX_RETRIES=2

# --- Agent ----------------------------------------------------------------
AGENT_MAX_STEPS=8
